(assume t0 target_pinned)
(assume t1 (not incarnation_known))
(assume t2 allowed)
(step t3 (cl (or incarnation_known (not (and incarnation_known incarnation_match)))) :rule hole)
(step t4 (cl incarnation_known (not (and incarnation_known incarnation_match))) :rule or :premises (t3))
(step t5 (cl (or (not target_pinned) (and incarnation_known incarnation_match) (not (or (not target_pinned) (and incarnation_known incarnation_match))))) :rule hole)
(step t6 (cl (not target_pinned) (not (or (not target_pinned) (and incarnation_known incarnation_match))) (and incarnation_known incarnation_match)) :rule or :premises (t5))
(step t7 (cl (or revoked (and has_expiry (bvule expires_at now_ms)) (not gen_match) (not op_granted) (not target_found) (and target_pinned (or (not incarnation_known) (not incarnation_match)))) (or (not target_pinned) (and incarnation_known incarnation_match))) :rule and_pos :args (3))
(step t8 (cl (or (not target_pinned) (and incarnation_known incarnation_match))) :rule th_resolution :premises (t7 t2))
(step t9 (cl (not target_pinned) (not (or (not target_pinned) (and incarnation_known incarnation_match))) incarnation_known) :rule resolution :premises (t6 t4))
(step t10 (cl (not target_pinned) incarnation_known) :rule resolution :premises (t9 t8))
(step t11 (cl (not target_pinned)) :rule resolution :premises (t10 t1))
(step t12 (cl) :rule resolution :premises (t11 t0))
