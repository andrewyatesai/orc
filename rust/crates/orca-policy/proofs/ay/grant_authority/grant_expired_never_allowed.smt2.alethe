(assume t0 expired)
(step t1 (cl (or (not has_expiry) (not (bvule expires_at now_ms))) has_expiry) :rule and_pos :args (0))
(step t2 (cl has_expiry) :rule th_resolution :premises (t1 t0))
(step t3 (cl (or (not has_expiry) (not (bvule expires_at now_ms))) (bvule expires_at now_ms)) :rule and_pos :args (1))
(step t4 (cl (bvule expires_at now_ms)) :rule th_resolution :premises (t3 t0))
(assume t5 allowed)
(step t6 (cl (or (not has_expiry) (not (bvule expires_at now_ms)) (not (or (not has_expiry) (not (bvule expires_at now_ms)))))) :rule hole)
(step t7 (cl (not has_expiry) (not (bvule expires_at now_ms)) (not (or (not has_expiry) (not (bvule expires_at now_ms))))) :rule or :premises (t6))
(step t8 (cl (or revoked expired (not gen_match) (not op_granted) (not target_found) (and target_pinned (or (not incarnation_known) (not incarnation_match)))) (or (not has_expiry) (not (bvule expires_at now_ms)))) :rule and_pos :args (5))
(step t9 (cl (or (not has_expiry) (not (bvule expires_at now_ms)))) :rule th_resolution :premises (t8 t5))
(step t10 (cl (not has_expiry) (not (bvule expires_at now_ms))) :rule resolution :premises (t7 t9))
(step t11 (cl (not has_expiry)) :rule resolution :premises (t10 t4))
(step t12 (cl) :rule resolution :premises (t11 t2))
