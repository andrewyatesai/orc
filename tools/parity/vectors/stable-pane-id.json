      }
    },
    {
      "function": "parseLegacyNumericPaneKey",
      "note": "cap boundary: 257 UTF-16 units is rejected",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:12",
      "expected": null
    },
    {
      "function": "parseLegacyNumericPaneKey",
      "note": "the cap is applied to the UNTRIMMED input, so a short key behind 300 spaces is still rejected",
